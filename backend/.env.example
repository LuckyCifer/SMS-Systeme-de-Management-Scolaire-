# ── Django ────────────────────────────────────────────
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=True

# ── MySQL ─────────────────────────────────────────────
DB_NAME=sms
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ── Hosts (production) ────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Production uniquement (ignoré si DEBUG=True) ───────
# Domaine(s) du frontend, séparés par des virgules :
# CORS_ALLOWED_ORIGINS=https://sms.example.cm,https://www.sms.example.cm
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# BEHIND_HTTPS_PROXY=True   # uniquement si un reverse-proxy (nginx…) termine le TLS

# ── Email (convocations, notifications, reçus) ─────────
# En dev, EMAIL_BACKEND=console affiche les emails dans le terminal — rien à configurer.
# En prod, passer sur smtp et renseigner les identifiants du fournisseur (Gmail, SendGrid…) :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=notifications@sms.example.cm
# EMAIL_HOST_PASSWORD=change-me
# DEFAULT_FROM_EMAIL=notifications@sms.example.cm
