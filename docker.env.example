# ── Overrides optionnels pour docker-compose.yml ────────────────────────────
# Ce fichier est FACULTATIF : docker-compose.yml fonctionne avec des valeurs
# par défaut sans lui. Pour personnaliser, copier en ".env" à la racine du
# projet (même dossier que docker-compose.yml) et modifier les valeurs.

MYSQL_ROOT_PASSWORD=smsroot
SECRET_KEY=django-insecure-docker-dev-only-change-me

# Mettre à "false" pour démarrer avec une base vide (pas de données de démo)
SEED_DEMO=true
